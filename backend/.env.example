# Set these only on the backend host. Never put them in the Android app source.
GEMINI_API_KEY=replace-with-your-server-side-key
# Optional but recommended: when set, clients must send this value in the X-Leanora-Token header.
# Enter the same value in the app under Settings -> AI backend -> Access token.
LEANORA_API_TOKEN=replace-with-a-long-random-string
# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# RATE_LIMIT_PER_MINUTE=30
